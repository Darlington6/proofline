{
  "name": "proofline",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered transaction safety for Solana.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "^8.6.0",
    "@solana/kit-plugin-rpc": "^0.23.0",
    "@solana/kit-plugin-wallet": "^0.23.0",
    "@solana/react": "^8.6.0",
    "lucide-react": "^1.70.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "^5.1.0"
  }
}
