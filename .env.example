# Public development configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: enables model-backed explanations. Without this, Proofline uses its
# deterministic rules engine and labels the result as rules-based.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Add project-specific public addresses here once the protocol is selected.
# Never add private keys, seed phrases, or wallet secret material to this file.
