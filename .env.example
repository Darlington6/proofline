# Public development configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: public address of a funded Devnet wallet you control. Lets visitors
# without a wallet run the scenarios in review-only mode. No key is needed.
NEXT_PUBLIC_DEMO_WALLET=

# Optional: server-only RPC override for the API routes (for example a keyed
# provider URL you do not want in the browser bundle).
SOLANA_RPC_URL=

# Optional: enables model-backed explanations. Without this, Proofline uses its
# deterministic rules engine and labels the result as rules-based.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible provider override. Use these instead of the
# OPENAI_* values when a provider exposes a compatible chat completions API.
# Google Gemini (free tier, key from https://aistudio.google.com/apikey):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Add project-specific public addresses here once the protocol is selected.
# Never add private keys, seed phrases, or wallet secret material to this file.
